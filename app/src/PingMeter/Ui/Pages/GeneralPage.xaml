<Page
    x:Class="PingMeter.Ui.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="General"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--  PreviewMouseWheel: without it the wheel only works over the scrollbar itself,
          and child controls (the target list) swallow it entirely.  -->
    <ScrollViewer
        x:Name="PageScroll"
        HorizontalScrollBarVisibility="Disabled"
        PreviewMouseWheel="OnPreviewMouseWheel"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="General" />
            <TextBlock
                Margin="0,0,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="What PingMeter watches, and how it looks in the taskbar." />

            <!--  Targets  -->
            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="Websites or servers to ping" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="NewTargetBox"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            KeyDown="OnNewTargetKeyDown"
                            PlaceholderText="type a website, e.g. google.com"
                            Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Click="OnAddTarget"
                            Content="Add"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>

                    <ListBox
                        x:Name="TargetList"
                        MaxHeight="160"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Targets}" />

                    <Grid Margin="0,12,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Switch the active one from the right-click menu."
                            TextWrapping="Wrap" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            Click="OnRemoveTarget"
                            Content="Remove"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Ping speed  -->
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Timer24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Ping every" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="How often a ping is sent." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:NumberBox
                        Width="136"
                        ClearButtonEnabled="False"
                        MaxDecimalPlaces="1"
                        Maximum="60"
                        Minimum="0.3"
                        SmallChange="0.5"
                        Value="{Binding IntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="seconds" />
                </StackPanel>
            </ui:CardControl>

            <!--  Colors  -->
            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="Taskbar colors" />
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Filled="True" Foreground="#66BB6A" Symbol="Circle24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Green — fast" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Replies faster than this look healthy." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:NumberBox
                        Width="136"
                        ClearButtonEnabled="False"
                        MaxDecimalPlaces="0"
                        Maximum="5000"
                        Minimum="1"
                        SmallChange="5"
                        Value="{Binding GreenBelowMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="ms" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Filled="True" Foreground="#FFB300" Symbol="Circle24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Yellow — okay" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Above this limit the number turns red." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:NumberBox
                        Width="136"
                        ClearButtonEnabled="False"
                        MaxDecimalPlaces="0"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="5"
                        Value="{Binding YellowBelowMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="ms" />
                </StackPanel>
            </ui:CardControl>

            <!--  Display + startup  -->
            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="Display" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DataHistogram24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Show mini graph" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="A tiny bar graph of the recent pings next to the number." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShowSparkline, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowTrendingDown24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Show packet loss %" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="When pings go missing, a red percentage appears next to the number." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShowLossOnWidget, Mode=TwoWay}" />
            </ui:CardControl>

            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="Startup" />
            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Start automatically when I turn on my PC" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="PingMeter appears in the taskbar every time Windows starts." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
