<UserControl
    x:Class="PingMeter.Ui.Pages.NetworkToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Network tools" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Fix the connection and choose which DNS server you use. Windows asks for permission before anything changes."
                TextWrapping="Wrap" />

            <ui:InfoBar
                x:Name="Info"
                Margin="0,0,0,16"
                IsClosable="True"
                IsOpen="False" />

            <!--  Restart offer, shown after a reset that needs one  -->
            <ui:InfoBar
                x:Name="RestartBar"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="Restart required">
                <ui:InfoBar.Content>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button
                            x:Name="RestartNowButton"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="OnRestartNow"
                            Content="Restart now" />
                        <ui:Button
                            x:Name="RestartCancelButton"
                            Click="OnRestartLater"
                            Content="Later" />
                    </StackPanel>
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="Repair your connection" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Flash24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Quick fix — clear DNS cache" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Fixes most &quot;website not found&quot; problems. Instant and safe — no admin prompt, no restart."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    x:Name="QuickFixButton"
                    Click="OnQuickFix"
                    Content="Run" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Full reset — rebuild the connection" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="The full 5-step repair: clear DNS, new IP address, reset Winsock and TCP/IP. A restart is needed afterwards."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    x:Name="FullResetButton"
                    Click="OnFullReset"
                    Content="Reset" />
            </ui:CardControl>

            <ProgressBar
                x:Name="Progress"
                Height="4"
                Margin="0,8,0,4"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Margin="0,0,0,4"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="DNS server" />

            <ui:Card Margin="0,0,0,8" Padding="16">
                <StackPanel>
                    <TextBlock
                        x:Name="DnsCurrent"
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <ComboBox
                        x:Name="PresetBox"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnPresetChanged" />

                    <!--  Columns match the DNS over HTTPS grid below, so the two rows line up  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Main" />
                            <ui:TextBox
                                x:Name="DnsPrimary"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="1.1.1.1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Backup" />
                            <ui:TextBox
                                x:Name="DnsSecondary"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="optional" />
                        </StackPanel>
                    </Grid>

                    <!--  DNS over HTTPS, per server, mirroring the Windows 11 settings page  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="DNS over HTTPS" />
                            <ComboBox
                                x:Name="PrimaryDoh"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnDohChanged" />
                            <ui:TextBox
                                x:Name="PrimaryDohTemplate"
                                Margin="0,6,0,0"
                                PlaceholderText="https://dns.example.com/dns-query"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="DNS over HTTPS" />
                            <ComboBox
                                x:Name="SecondaryDoh"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnDohChanged" />
                            <ui:TextBox
                                x:Name="SecondaryDohTemplate"
                                Margin="0,6,0,0"
                                PlaceholderText="https://dns.example.com/dns-query"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            x:Name="ApplyDnsButton"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="OnApplyDns"
                            Content="Apply DNS" />
                        <ui:Button
                            x:Name="SavePresetButton"
                            Margin="0,0,8,0"
                            Click="OnSavePreset"
                            Content="Save as preset…" />
                        <ui:Button
                            x:Name="DeletePresetButton"
                            Click="OnDeletePreset"
                            Content="Delete preset" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="DNS is the phone book that turns website names into addresses. Save a combination to reuse it later; switching back to Automatic undoes everything."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="Activity" />
            <ui:TextBox
                x:Name="ActivityLog"
                Height="150"
                AcceptsReturn="True"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
