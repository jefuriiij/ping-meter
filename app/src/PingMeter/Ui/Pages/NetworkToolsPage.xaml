<UserControl
    x:Class="PingMeter.Ui.Pages.NetworkToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Network tools" />
            <TextBlock
                Margin="0,0,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Fix the connection and choose which DNS server you use. Windows asks for permission before anything changes."
                TextWrapping="Wrap" />

            <ui:InfoBar
                x:Name="Info"
                Margin="0,0,0,16"
                IsClosable="True"
                IsOpen="False" />

            <!--  Restart offer, shown after a reset that needs one  -->
            <ui:InfoBar
                x:Name="RestartBar"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="Restart required">
                <ui:InfoBar.Content>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button
                            x:Name="RestartNowButton"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="OnRestartNow"
                            Content="Restart now" />
                        <ui:Button
                            x:Name="RestartCancelButton"
                            Click="OnRestartLater"
                            Content="Later" />
                    </StackPanel>
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="Repair your connection" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Flash24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="Quick fix" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Clears the DNS cache. Fixes most &quot;website not found&quot; problems, with no restart. Some Windows versions ask for permission first."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    x:Name="QuickFixButton"
                    MinWidth="80"
                    Click="OnQuickFix"
                    Content="Run" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="Full reset" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Rebuilds the connection in 5 steps: clear DNS, new IP address, reset Winsock and TCP/IP. Needs a restart to finish."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    x:Name="FullResetButton"
                    MinWidth="80"
                    Click="OnFullReset"
                    Content="Reset" />
            </ui:CardControl>

            <!--  Shown only while a repair or DNS change runs  -->
            <ProgressBar
                x:Name="Progress"
                Height="4"
                Margin="0,12,0,0"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <TextBlock
                Margin="0,20,0,4"
                FontWeight="SemiBold"
                Text="DNS server" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="DNS is the phone book that turns website names into addresses. Save a combination to reuse it later. Switch back to Automatic to undo everything."
                TextWrapping="Wrap" />

            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock
                        x:Name="DnsCurrent"
                        Margin="0,0,0,16"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,4"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Provider" />
                    <ComboBox
                        x:Name="PresetBox"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnPresetChanged" />

                    <!--  One column per server: its address, then its encryption under it  -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Main" />
                            <ui:TextBox
                                x:Name="DnsPrimary"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="1.1.1.1" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="DNS over HTTPS" />
                            <ComboBox
                                x:Name="PrimaryDoh"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnDohChanged" />
                            <ui:TextBox
                                x:Name="PrimaryDohTemplate"
                                Margin="0,6,0,0"
                                PlaceholderText="https://dns.example.com/dns-query"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Backup" />
                            <ui:TextBox
                                x:Name="DnsSecondary"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="optional" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="DNS over HTTPS" />
                            <ComboBox
                                x:Name="SecondaryDoh"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnDohChanged" />
                            <ui:TextBox
                                x:Name="SecondaryDohTemplate"
                                Margin="0,6,0,0"
                                PlaceholderText="https://dns.example.com/dns-query"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!--  Preset housekeeping on the left, the action that changes Windows on the right  -->
                    <DockPanel LastChildFill="False">
                        <ui:Button
                            x:Name="ApplyDnsButton"
                            MinWidth="96"
                            Appearance="Primary"
                            Click="OnApplyDns"
                            Content="Apply DNS"
                            DockPanel.Dock="Right" />
                        <ui:Button
                            x:Name="SavePresetButton"
                            Margin="0,0,8,0"
                            Click="OnSavePreset"
                            Content="Save as preset…"
                            DockPanel.Dock="Left" />
                        <ui:Button
                            x:Name="DeletePresetButton"
                            Click="OnDeletePreset"
                            Content="Delete preset"
                            DockPanel.Dock="Left" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <!--  Appears with the first entry, so an unused page has no empty box  -->
            <StackPanel x:Name="ActivitySection" Visibility="Collapsed">
                <TextBlock
                    Margin="0,20,0,8"
                    FontWeight="SemiBold"
                    Text="Activity" />
                <ui:TextBox
                    x:Name="ActivityLog"
                    Height="120"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
