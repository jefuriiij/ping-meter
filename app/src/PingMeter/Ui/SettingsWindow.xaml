<ui:FluentWindow
    x:Class="PingMeter.Ui.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:PingMeter.Ui.Pages"
    Title="PingMeter Settings"
    Width="880"
    Height="620"
    MinWidth="620"
    MinHeight="420"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="PingMeter Settings"
            ShowMaximize="True" />

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="190"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="General"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItem
                    Content="Advanced"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem
                    Content="Network tools"
                    Icon="{ui:SymbolIcon Wrench24}"
                    TargetPageType="{x:Type pages:PlaceholderPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2" Padding="20,12">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel"
                    IsCancel="True" />
                <ui:Button
                    MinWidth="96"
                    Appearance="Primary"
                    Click="OnSave"
                    Content="Save"
                    IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
