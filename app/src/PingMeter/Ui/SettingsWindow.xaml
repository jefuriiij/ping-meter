<ui:FluentWindow
    x:Class="PingMeter.Ui.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PingMeter Settings"
    Width="880"
    Height="620"
    MinWidth="620"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    PreviewMouseWheel="OnPreviewMouseWheel"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!--  Sidebar entries: flat, rounded, with an accent bar when selected.  -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="5">
                            <Grid>
                                <Rectangle
                                    x:Name="Accent"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="Collapsed" />
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="PingMeter Settings"
            ShowMaximize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox
                x:Name="NavList"
                Grid.Column="0"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource NavItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="OnNavigationChanged">
                <ListBoxItem IsSelected="True" Tag="general">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,12,0" Symbol="Home24" />
                        <TextBlock VerticalAlignment="Center" Text="General" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="advanced">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,12,0" Symbol="Settings24" />
                        <TextBlock VerticalAlignment="Center" Text="Advanced" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="network">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,12,0" Symbol="Wrench24" />
                        <TextBlock VerticalAlignment="Center" Text="Network tools" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!--  A plain ContentControl: the page inside gets a bounded height, so its
                  own ScrollViewer actually scrolls (NavigationView's frame did not).  -->
            <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="2" Padding="20,12">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel"
                    IsCancel="True" />
                <ui:Button
                    MinWidth="96"
                    Appearance="Primary"
                    Click="OnSave"
                    Content="Save"
                    IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
