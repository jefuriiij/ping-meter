<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms for the taskbar widget/tray (needs a raw reparentable HWND);
         WPF only for the settings window. Both live in the same process. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- WinForms dark color mode is still marked experimental (WFO5001) -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PingMeter</RootNamespace>
    <AssemblyName>PingMeter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.5.0</Version>
    <Description>Taskbar-embedded ping monitor</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enabling UseWPF drops System.IO from the implicit usings the WinForms-only
         build had; restore it so the existing file/logging code keeps compiling. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
